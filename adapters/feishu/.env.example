# Feishu bot target. Do not commit the real values.
CHAT_ID=oc_xxx
IDENTITY=bot
MENTION_TRIGGERS='@Friendly AI Assistant'
MENTION_IDS=

# LLM is used only to split a title into semantic phrases before Canvas rendering.
OPENAI_BASE_URL=https://api.openai.com
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_EVA_SEGMENTATION_MODEL=
OPENAI_TIMEOUT_SECONDS=45

# Local native Canvas EVA runtime. Point to the installed `skills/eva` folder
# when this optional adapter lives outside the Hermes skill directory.
EVA_TITLE_LOCAL_DIR=skills/eva
EVA_TITLE_NODE_PATH=node
EVA_TITLE_RENDER_TIMEOUT_SECONDS=45

# Runtime data stays untracked.
LISTENER_LOG_DIR=logs
LISTENER_STATE_DIR=state
REACTION_ENABLED=1
REACTION_DONE_ENABLED=1
REPLY_ENABLED=1
EVA_ONLY=1
